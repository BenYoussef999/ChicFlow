<?xml version="1.0" encoding="utf-8"?>
<!--
  By default Android blocks plain http://. The deployed server must use https://.
  For LOCAL testing only (XAMPP on your PC) we allow http for these addresses:
    10.0.2.2  = your PC as seen from the Android emulator
  If you test with a real phone on the same Wi-Fi, add your PC's IP here
  (e.g. 192.168.1.20) and REMOVE it again before the final build.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
